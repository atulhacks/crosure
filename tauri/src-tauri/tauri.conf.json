{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crosure",
  "version": "0.1.1",
  "identifier": "dev.crosure.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crosure",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Crosure",
    "copyright": "Copyright 2026 the Crosure authors. Apache-2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Reverse-engineering workbench that records every step",
    "longDescription": "Crosure is a reverse-engineering workbench. Every action, yours or an AI agent's, is a recorded, hash-chained step on an investigation graph, and investigations export as training data.",
    "license": "Apache-2.0",
    "homepage": "https://github.com/atulhacks/crosure",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
